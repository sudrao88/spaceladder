# Google Cast / Chromecast configuration
#
# Register a Custom Receiver in the Google Cast Developer Console
# (https://cast.google.com/publish/) pointing at the HTTPS URL where you
# host `dist/receiver.html`. Paste the resulting Application ID below.
#
# If VITE_CAST_RECEIVER_APP_ID is empty, the Cast button stays hidden so
# users never see a broken control.
VITE_CAST_RECEIVER_APP_ID=

# Custom message namespace shared by sender and receiver. Must start with
# "urn:x-cast:" and stay consistent between deploys. The default below is
# fine for most setups; override only if you have a conflicting namespace.
VITE_CAST_NAMESPACE=urn:x-cast:com.spaceladders.game
